# Copy to .env (gitignored). The code reads it on start. The live demo runs without any of these.

# Claude, for the flight engineer (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# Optional model override; claude-opus-5-5 costs half
FALCON_MODEL=claude-fable-5-2

# Optional: live site wind forecast with sources
LINKUP_API_KEY=

# Optional: log every flight to MLflow on Databricks (uv sync --extra track)
MLFLOW_TRACKING_URI=
DATABRICKS_HOST=
DATABRICKS_TOKEN=
